generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================
// AUTH
// =========================================================

model Role {
  id          String  @id @default(uuid())
  name        String  @unique   // "Administrator", "Building & Grounds Officer", "Property Custodian", "Faculty", "Campus Staff"
  description String?
  users       User[]
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String
  firstName    String
  lastName     String
  isActive     Boolean @default(true)

  // Security
  lastLoginAt         DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  notifications       Notification[]

  requestedWorkRequests  WorkRequest[]               @relation("RequestedWorkRequests")
  assignedWorkRequests   WorkRequest[]               @relation("AssignedWorkRequests")
  workRequestAssignments WorkRequestAssignment[]
  accomplishments        WorkRequestAccomplishment[]

  issuancesAsCustodian   ItemIssuance[]        @relation("IssuanceCustodian")
  withdrawalsAsCustodian WarehouseWithdrawal[] @relation("WithdrawalCustodian")

  requestedPurchaseRequests PurchaseRequest[] @relation("RequestedPurchaseRequests")
  approvedPurchaseRequests  PurchaseRequest[] @relation("ApprovedPurchaseRequests")

  createdMaintenanceSchedules MaintenanceSchedule[]

  stockMovementsPerformed StockMovement[]

  auditLogs AuditLog[]

  @@index([roleId])

  positionId String?
  position   Position? @relation(fields: [positionId], references: [id])

  @@index([positionId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// =========================================================
// NOTIFICATIONS
// =========================================================

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  workRequestId String?
  workRequest   WorkRequest? @relation(fields: [workRequestId], references: [id])

  @@index([userId])
  @@index([isRead])
}

// =================================1========================
// INVENTORY
// =========================================================

enum ItemStatus {
  GOOD_CONDITION
  BORROWED
  UNDER_REPAIR
  DAMAGED
  LOST
  FOR_DISPOSAL
  DISPOSED
  RESERVED
}

enum ItemType {
  CONSUMABLE
  ASSET
  TOOL
}

enum Campus {
  MC1
  MC2
  PAMPLONA
}

enum ProjectType {
  CONSTRUCTION
  RENOVATION
  FABRICATION
}

model Project {
  id                String        @id @default(uuid())
  name              String
  description       String?
  startDate         DateTime?
  endDate           DateTime?
  status            ProjectStatus @default(ONGOING)
  createdAt         DateTime      @default(now())

  // Control No. from the Detailed Estimate of Materials document, if imported
  estimateControlNo String?       @unique
  type   ProjectType
  campus Campus

  items             InventoryItem[]
  materialEstimates MaterialEstimate[]
  purchaseRequests  PurchaseRequest[]
}

enum ProjectStatus {
  ONGOING
  COMPLETED
  ON_HOLD
  CANCELLED
}

model InventoryItem {
  id             String   @id @default(uuid())
  name           String
  type           ItemType
  description    String?
  quantity       Decimal  @default(1)
  unit           String?  // "PCS", "LENGTH", "KG", "CU. MTR.", etc.
  location       String?
  isActive Boolean @default(true)
  propertyNumber String?  @unique
  serialNumber   String?  @unique

  unitCost        Decimal?
  totalValue      Decimal?
  acquisitionDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // null = common/general stock, set = belongs to a specific project
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  workRequests         WorkRequest[]
  issuances            ItemIssuance[]
  withdrawals          WarehouseWithdrawal[]
  maintenanceSchedules MaintenanceSchedule[]
  stockMovements       StockMovement[]
  categoryId String?
  category   ItemCategory? @relation(fields: [categoryId], references: [id])
  campus Campus
  status ItemStatus @default(GOOD_CONDITION)
  @@index([categoryId])
  @@index([projectId])
  @@index([type])
}

model ItemCategory {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  items       InventoryItem[]
}

// =========================================================
// STOCK MOVEMENT (quantity change ledger / "stock card")
// =========================================================

model StockMovement {
  id             String   @id @default(uuid())
  movementType   String   // "RECEIVED", "WITHDRAWN", "ADJUSTED"
  quantityChange Decimal  // positive for increases, negative for decreases
  quantityAfter  Decimal  // snapshot of quantity right after this movement
  reason         String?

  // Optional traceability back to the record that caused this movement
  referenceType String?  // "WarehouseWithdrawal", "Manual"
  referenceId   String?

  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])

  performedById String
  performedBy   User   @relation(fields: [performedById], references: [id])

  createdAt DateTime @default(now())

  @@index([inventoryItemId])
  @@index([createdAt])
}

// =========================================================
// WORK REQUESTS (a.k.a. Job Orders — same record, richer over time)
// =========================================================

enum RequestType {
  REGULAR_MAINTENANCE
  REPAIR
  FABRICATION
  INSTALLATION
  REPLACEMENT
  PLAN_DESIGN
  BAYANIHAN
  OTHERS
}

enum RequestStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model WorkRequest {
  id               String        @id @default(uuid())
  referenceNo      String        @unique // Control Number / Work Number — e.g. "WR-2026-0001"
  requestType      RequestType
  requestingOffice String
  particulars      String?

  // type-specific fields, shape depends on requestType
  details Json?

  status          RequestStatus @default(PENDING)
  deadline        DateTime?
  progressPercent Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requestedById String
  requestedBy   User   @relation("RequestedWorkRequests", fields: [requestedById], references: [id])

  // Primary/lead assignee (quick reference)
  assignedToId String?
  assignedTo   User?   @relation("AssignedWorkRequests", fields: [assignedToId], references: [id])

  // Full crew with individual roles (Technician, Plumber, Electrician, etc.)
  assignments WorkRequestAssignment[]

  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  campus Campus
  accomplishment WorkRequestAccomplishment?
  notifications  Notification[]

  @@index([requestedById])
  @@index([assignedToId])
  @@index([status])
  @@index([inventoryItemId])
}

model WorkRequestAssignment {
  id         String   @id @default(uuid())
  role       String   // "Technician", "Plumber", "Electrician", "Lead", etc.
  assignedAt DateTime @default(now())

  workRequestId String
  workRequest   WorkRequest @relation(fields: [workRequestId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([workRequestId, userId, role])
  @@index([workRequestId])
  @@index([userId])
}

model WorkRequestAccomplishment {
  id                String    @id @default(uuid())
  dateTimeStarted   DateTime?
  dateTimeCompleted DateTime?

  // type-specific completion details as JSON
  completionDetails Json?

  serviceRating     Int?    // 1-5
  expectationRating Int?    // 1-5
  comments          String?

  workRequestId String      @unique
  workRequest   WorkRequest @relation(fields: [workRequestId], references: [id])

  bgPersonnelId String
  bgPersonnel   User   @relation(fields: [bgPersonnelId], references: [id])

  createdAt DateTime @default(now())
}

// =========================================================
// ITEM ISSUANCE / RETURN TRACKING
// =========================================================

model ItemIssuance {
  id            String @id @default(uuid())
  controlNumber String @unique

  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  quantity        Int           @default(1)

  borrowerName  String
  studentId     String? // if borrower is a student
  contactNumber String? // if borrower is external/staff without a student ID

  custodianId String
  custodian   User   @relation("IssuanceCustodian", fields: [custodianId], references: [id])

  issuedAt   DateTime  @default(now())
  dueBackAt  DateTime?
  returnedAt DateTime?

  @@index([inventoryItemId])
  @@index([custodianId])
}

// =========================================================
// WAREHOUSE (BODEGA) WITHDRAWALS
// =========================================================

model WarehouseWithdrawal {
  id             String @id @default(uuid())
  issuanceSlipNo String @unique

  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  quantity        Int

  withdrawnByName String // person/office who took the consumables

  custodianId String
  custodian   User   @relation("WithdrawalCustodian", fields: [custodianId], references: [id])

  withdrawnAt DateTime @default(now())

  @@index([inventoryItemId])
  @@index([custodianId])
}

// =========================================================
// PROCUREMENT: DETAILED ESTIMATES -> PURCHASE REQUESTS
// =========================================================

model MaterialEstimate {
  id          String   @id @default(uuid())
  category    String?  // section header, e.g. "MASONRY WORKS"
  itemNo      String?  // e.g. "1.1"
  description String
  quantity    Decimal
  unit        String
  unitCost    Decimal
  amount      Decimal
  createdAt   DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  purchaseRequestItems PurchaseRequestItem[]

  @@index([projectId])
}

enum PurchaseRequestStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model PurchaseRequest {
  id               String                @id @default(uuid())
  controlNo        String                @unique // e.g. "PR-2026-0001"
  requestingOffice String
  purpose          String?
  status           PurchaseRequestStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  requestedById String
  requestedBy   User   @relation("RequestedPurchaseRequests", fields: [requestedById], references: [id])

  approvedById String?
  approvedBy   User?     @relation("ApprovedPurchaseRequests", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  items PurchaseRequestItem[]

  @@index([projectId])
  @@index([requestedById])
  @@index([status])
}

model PurchaseRequestItem {
  id          String  @id @default(uuid())
  description String
  quantity    Decimal
  unit        String
  unitCost    Decimal
  totalCost   Decimal

  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id])

  // traceability back to the original estimate line, if converted from one
  materialEstimateId String?
  materialEstimate   MaterialEstimate? @relation(fields: [materialEstimateId], references: [id])

  @@index([purchaseRequestId])
}

// =========================================================
// PREVENTIVE MAINTENANCE SCHEDULE
// =========================================================

model MaintenanceSchedule {
  id              String    @id @default(uuid())
  title           String    // "Quarterly Aircon Cleaning"
  frequencyDays   Int       // e.g. 90 for every 3 months
  lastPerformedAt DateTime?
  nextDueAt       DateTime
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())

  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  @@index([inventoryItemId])
  @@index([nextDueAt])
  @@index([isActive])
}

// =========================================================
// AUDIT LOG
// =========================================================

model AuditLog {
  id         String   @id @default(uuid())
  action     String   // "CREATE", "UPDATE", "DELETE", "APPROVE", "REJECT", etc.
  entityType String   // "InventoryItem", "PurchaseRequest", "User", "WorkRequest", etc.
  entityId   String

  description String?
  metadata    Json?

  performedById String
  performedBy   User   @relation(fields: [performedById], references: [id])

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([performedById])
  @@index([createdAt])
}

// =========================================================
// SHARED SEQUENTIAL NUMBER GENERATOR
// (Work Requests, Issuances, Withdrawals, Purchase Requests all use this)
// =========================================================

model SequenceCounter {
  type  String // "WR", "ISS", "WH", "PR"
  year  Int
  count Int    @default(0)

  @@id([type, year])
}

model Position {
  id          String  @id @default(uuid())
  name        String  @unique   // "Technician", "Electrician", "Plumber", "Cleaning Utility", etc.
  description String?
  users       User[]
}