generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  users       User[]   @relation("UserRole")
}

model User {
  id                          String                      @id @default(uuid())
  email                       String                      @unique
  passwordHash                String
  firstName                   String
  lastName                    String
  isActive                    Boolean                     @default(true)
  lastLoginAt                 DateTime?
  failedLoginAttempts         Int                         @default(0)
  lockedUntil                 DateTime?
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  roleId                      String
  positionId                  String?
  officeId                    String?
  transfersApproved           AssetTransfer[]             @relation("ApprovedTransfer")
  receivedTransfers           AssetTransfer[]             @relation("PersonReceivedTransfers")
  transfersInitiated          AssetTransfer[]             @relation("TransferredBy")
  auditLogs                   AuditLog[]                  @relation("AuditPerformer")
  borrowRequestsApproved      BorrowRequest[]             @relation("BorrowApprover")
  borrowRequestsRequested     BorrowRequest[]             @relation("BorrowRequester")
  transactionsAsCustodian     ItemTransaction[]           @relation("TransactionCustodian")
  createdMaintenanceSchedules MaintenanceSchedule[]       @relation("MaintenanceCreator")
  notifications               Notification[]              @relation("UserNotifications")
  passwordResetTokens         PasswordResetToken[]        @relation("UserPasswordResetTokens")
  approvedPurchaseRequests    PurchaseRequest[]           @relation("ApprovedPurchaseRequests")
  requestedPurchaseRequests   PurchaseRequest[]           @relation("RequestedPurchaseRequests")
  refreshTokens               RefreshToken[]              @relation("UserRefreshTokens")
  stockMovementsPerformed     StockMovement[]             @relation("StockMovementPerformer")
  office                      Office?                     @relation("UserOffice", fields: [officeId], references: [id])
  position                    Position?                   @relation("PositionUsers", fields: [positionId], references: [id])
  role                        Role                        @relation("UserRole", fields: [roleId], references: [id])
  requestedWorkRequests       WorkRequest[]               @relation("RequestedWorkRequests")
  accomplishments             WorkRequestAccomplishment[] @relation("AccomplishmentPersonnel")
  workRequestAssignments      WorkRequestAssignment[]     @relation("WorkRequestAssignmentUser")
  approvedWorkRequests        WorkRequest[]               @relation("WorkRequestApprovedBy")
  rejectedWorkRequests        WorkRequest[]               @relation("WorkRequestRejectedBy")
  runHourReadingsRecorded RunHourReading[] @relation("RunHourReadingRecordedBy")
  
  @@index([roleId])
  @@index([positionId])
  @@index([officeId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation("UserRefreshTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation("UserPasswordResetTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Notification {
  id            String       @id @default(uuid())
  title         String
  message       String
  isRead        Boolean      @default(false)
  createdAt     DateTime     @default(now())
  userId        String
  workRequestId String?
  user          User         @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  workRequest   WorkRequest? @relation("WorkRequestNotifications", fields: [workRequestId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model Office {
  id               String            @id @default(uuid())
  name             String
  campus           Campus
  description      String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  purchaseRequests PurchaseRequest[] @relation("OfficePurchaseRequests")
  users            User[]            @relation("UserOffice")
  workRequests     WorkRequest[]     @relation("OfficeWorkRequests")

  @@unique([name, campus])
  @@index([campus])
}

model Person {
  id                     String            @id @default(uuid())
  firstName              String
  lastName               String
  studentId              String?           @unique
  contactNumber          String?
  type                   PersonType        @default(EXTERNAL)
  isActive               Boolean           @default(true)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  assetTransfersAsHolder AssetTransfer[]   @relation("TransferNewHolder")
  transactions           ItemTransaction[] @relation("PersonTransactions")

  @@index([studentId])
  @@index([type])
  @@index([lastName])
}

model Position {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  users       User[]   @relation("PositionUsers")
  assetTypeConfigs AssetTypeConfig[] @relation("AssetTypeConfigPosition")
}

model AnnualBudget {
  id          String             @id @default(uuid())
  year        Int                @unique
  totalAmount Decimal            @db.Decimal(19, 4)
  description String?
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  allocations BudgetAllocation[] @relation("BudgetAllocations")
}

model BudgetAllocation {
  id               String            @id @default(uuid())
  name             String
  trade            Trade
  allocatedAmount  Decimal           @db.Decimal(19, 4)
  annualBudgetId   String
  projectId        String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  annualBudget     AnnualBudget      @relation("BudgetAllocations", fields: [annualBudgetId], references: [id])
  project          Project?          @relation("ProjectBudgetAllocations", fields: [projectId], references: [id])
  purchaseRequests PurchaseRequest[] @relation("PurchaseRequestBudget")

  @@index([annualBudgetId])
  @@index([projectId])
  @@index([trade])
}

model Project {
  id                String             @id @default(uuid())
  name              String
  description       String?
  startDate         DateTime?
  endDate           DateTime?
  status            ProjectStatus      @default(ONGOING)
  createdAt         DateTime           @default(now())
  estimateControlNo String?            @unique
  campus            Campus
  type              ProjectType
  isActive          Boolean            @default(true)
  updatedAt         DateTime           @updatedAt
  budgetAllocations BudgetAllocation[] @relation("ProjectBudgetAllocations")
  items             InventoryItem[]    @relation("ProjectInventory")
  materialEstimates MaterialEstimate[] @relation("ProjectEstimates")
  purchaseRequests  PurchaseRequest[]  @relation("ProjectPurchaseRequests")

  @@index([campus])
  @@index([isActive])
}

model InventoryItem {
  id                      String     @id @default(uuid())
  name                    String
  type                    ItemType
  description             String?
  quantity                Decimal    @default(1) @db.Decimal(15, 4)
  location                String?
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt
  projectId               String?
  propertyNumber          String?    @unique
  serialNumber            String?    @unique
  acquisitionDate         DateTime?
  unit                    String?
  unitCost                Decimal?   @db.Decimal(19, 4)
  isActive                Boolean    @default(true)
  categoryId              String?
  campus                  Campus
  status                  ItemStatus @default(GOOD_CONDITION)
  sourcePurchaseRequestId String?

  transfers             AssetTransfer[]       @relation("ItemTransfers")
  borrowRequests        BorrowRequest[]       @relation("BorrowRequests")
  category              ItemCategory?         @relation("CategoryInventoryItems", fields: [categoryId], references: [id])
  project               Project?              @relation("ProjectInventory", fields: [projectId], references: [id])
  sourcePurchaseRequest PurchaseRequest?      @relation("SourcedInventoryItems", fields: [sourcePurchaseRequestId], references: [id])
  transactions          ItemTransaction[]     @relation("InventoryTransactions")
  maintenanceSchedules  MaintenanceSchedule[] @relation("ItemMaintenanceSchedules")
  stockMovements        StockMovement[]       @relation("ItemStockMovements")
  workRequestItems      WorkRequestItem[]     @relation("InventoryWorkRequestItems")
  maintainableAssetProfile MaintainableAssetProfile? @relation("InventoryMaintainableProfile")

  @@index([categoryId])
  @@index([projectId])
  @@index([type])
  @@index([status])
  @@index([campus])
  @@index([isActive])
  @@index([sourcePurchaseRequestId])
}

model ItemCategory {
  id          String          @id @default(uuid())
  name        String          @unique
  description String?
  createdAt   DateTime        @default(now())
  isActive    Boolean         @default(true)
  updatedAt   DateTime        @updatedAt
  items       InventoryItem[] @relation("CategoryInventoryItems")
}

model StockMovement {
  id                String            @id @default(uuid())
  quantityChange    Decimal           @db.Decimal(15, 4)
  quantityAfter     Decimal           @db.Decimal(15, 4)
  reason            String?
  referenceType     String?
  referenceId       String?
  inventoryItemId   String
  performedById     String
  createdAt         DateTime          @default(now())
  movementType      StockMovementType
  purchaseRequestId String?
  inventoryItem     InventoryItem     @relation("ItemStockMovements", fields: [inventoryItemId], references: [id])
  performedBy       User              @relation("StockMovementPerformer", fields: [performedById], references: [id])
  purchaseRequest   PurchaseRequest?  @relation("PurchaseStockMovements", fields: [purchaseRequestId], references: [id])

  @@index([inventoryItemId])
  @@index([createdAt])
  @@index([purchaseRequestId])
}

model ItemTransaction {
  id              String          @id @default(uuid())
  controlNumber   String          @unique
  transactionType TransactionType
  inventoryItemId String
  quantity        Decimal         @db.Decimal(15, 4)
  personId        String?
  custodianId     String
  transactionDate DateTime        @default(now())
  dueDate         DateTime?
  returnedAt      DateTime?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  borrowRequest   BorrowRequest?  @relation("BorrowTransaction")
  custodian       User            @relation("TransactionCustodian", fields: [custodianId], references: [id])
  inventoryItem   InventoryItem   @relation("InventoryTransactions", fields: [inventoryItemId], references: [id])
  person          Person?         @relation("PersonTransactions", fields: [personId], references: [id])

  @@index([inventoryItemId])
  @@index([personId])
  @@index([custodianId])
  @@index([transactionType])
  @@index([transactionDate])
  @@index([inventoryItemId, transactionType])
}

model AssetTransfer {
  id              String         @id @default(uuid())
  fromCampus      Campus
  toCampus        Campus
  transferDate    DateTime       @default(now())
  reason          String?
  transferredById String
  approvedById    String?
  receivedById    String?
  inventoryItemId String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  status          TransferStatus @default(PENDING)
  approvedAt      DateTime?
  batchId         String
  completedAt     DateTime?
  decisionNotes   String?
  newHolderId     String?
  quantity        Decimal        @db.Decimal(15, 4)
  rejectedAt      DateTime?

  approvedBy    User?         @relation("ApprovedTransfer", fields: [approvedById], references: [id])
  inventoryItem InventoryItem @relation("ItemTransfers", fields: [inventoryItemId], references: [id], onDelete: Cascade)
  newHolder     Person?       @relation("TransferNewHolder", fields: [newHolderId], references: [id])
  receivedBy    User?         @relation("PersonReceivedTransfers", fields: [receivedById], references: [id])
  transferredBy User          @relation("TransferredBy", fields: [transferredById], references: [id])

  @@index([inventoryItemId])
  @@index([status])
  @@index([batchId])
  @@index([newHolderId])
  @@index([fromCampus])
  @@index([inventoryItemId, status])
  @@index([toCampus])
  @@index([transferDate])
}

model WorkRequest {
  id                    String        @id @default(uuid())
  referenceNo           String        @unique
  requestType           RequestType
  particulars           String?
  details               Json?
  status                RequestStatus @default(PENDING)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  requestedById         String
  deadline              DateTime?
  progressPercent       Int           @default(0)
  campus                Campus
  isActive              Boolean       @default(true)
  maintenanceScheduleId String?
  requestingOfficeId    String?

  priority RequestPriority @default(NOT_URGENT)

  approvalStatus  ApprovalStatus @default(PENDING)
  approvalNotes   String?
  rejectionReason String?
  approvedAt      DateTime?
  approvedById    String?
  rejectedAt      DateTime?
  rejectedById    String?

  notifications       Notification[]             @relation("WorkRequestNotifications")
  maintenanceSchedule MaintenanceSchedule?       @relation("MaintenanceWorkRequests", fields: [maintenanceScheduleId], references: [id])
  requestedBy         User                       @relation("RequestedWorkRequests", fields: [requestedById], references: [id])
  requestingOffice    Office?                    @relation("OfficeWorkRequests", fields: [requestingOfficeId], references: [id])
  accomplishment      WorkRequestAccomplishment? @relation("WorkRequestAccomplishment")
  assignments         WorkRequestAssignment[]    @relation("WorkRequestAssignments")
  items               WorkRequestItem[]          @relation("WorkRequestItems")
  approvedBy          User?                      @relation("WorkRequestApprovedBy", fields: [approvedById], references: [id])
  rejectedBy          User?                      @relation("WorkRequestRejectedBy", fields: [rejectedById], references: [id])

  @@index([requestedById])
  @@index([status])
  @@index([campus])
  @@index([requestType])
  @@index([deadline])
  @@index([requestingOfficeId])
  @@index([maintenanceScheduleId])
  @@index([approvalStatus])
  @@index([priority])
}

model WorkRequestItem {
  id              String        @id @default(uuid())
  quantity        Decimal       @db.Decimal(15, 4)
  description     String?
  workRequestId   String
  inventoryItemId String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  inventoryItem   InventoryItem @relation("InventoryWorkRequestItems", fields: [inventoryItemId], references: [id])
  workRequest     WorkRequest   @relation("WorkRequestItems", fields: [workRequestId], references: [id], onDelete: Cascade)

  @@index([workRequestId])
  @@index([inventoryItemId])
}

model WorkRequestAssignment {
  id            String         @id @default(uuid())
  assignedAt    DateTime       @default(now())
  workRequestId String
  userId        String
  unassignedAt  DateTime?
  role          AssignmentRole
  user          User           @relation("WorkRequestAssignmentUser", fields: [userId], references: [id])
  workRequest   WorkRequest    @relation("WorkRequestAssignments", fields: [workRequestId], references: [id], onDelete: Cascade)

  @@index([workRequestId])
  @@index([userId])
}

model WorkRequestAccomplishment {
  id                String      @id @default(uuid())
  dateTimeStarted   DateTime?
  dateTimeCompleted DateTime?
  completionDetails Json?
  serviceRating     Int?
  expectationRating Int?
  comments          String?
  workRequestId     String      @unique
  bgPersonnelId     String
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  bgPersonnel       User        @relation("AccomplishmentPersonnel", fields: [bgPersonnelId], references: [id])
  workRequest       WorkRequest @relation("WorkRequestAccomplishment", fields: [workRequestId], references: [id], onDelete: Cascade)
}

model AssetTypeConfig {
  id         String                @id @default(uuid())
  assetType  MaintainableAssetType @unique
  positionId String
  notes      String?
  isActive   Boolean               @default(true)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  position Position @relation("AssetTypeConfigPosition", fields: [positionId], references: [id])
}

model MaintenanceSchedule {
  id              String            @id @default(uuid())
  title           String
  basis           MaintenanceBasis  @default(CALENDAR)   // NEW

  frequencyDays   Int?                                   // was required
  nextDueAt       DateTime?                               // was required

  frequencyHours  Decimal?          @db.Decimal(10, 2)    // NEW
  currentRunHours Decimal           @default(0) @db.Decimal(10, 2)  // NEW
  nextDueAtHours  Decimal?          @db.Decimal(10, 2)    // NEW

  notes           String?                                 // NEW

  lastPerformedAt DateTime?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  inventoryItemId String
  createdById     String
  createdBy       User             @relation("MaintenanceCreator", fields: [createdById], references: [id])
  inventoryItem   InventoryItem    @relation("ItemMaintenanceSchedules", fields: [inventoryItemId], references: [id], onDelete: Cascade)
  workRequests    WorkRequest[]    @relation("MaintenanceWorkRequests")
  runHourReadings RunHourReading[] @relation("ScheduleRunHourReadings")  // NEW

  @@index([inventoryItemId])
  @@index([nextDueAt])
  @@index([isActive])
  @@index([isActive, nextDueAt])
  @@index([basis])                                        // NEW
}

model MaintainableAssetProfile {
  id              String                @id @default(uuid())
  inventoryItemId String                @unique
  assetType       MaintainableAssetType
  priority        MaintenancePriority   @default(ROUTINE)
  notes           String?
  isActive        Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  unitTypeConfigId String?

  inventoryItem  InventoryItem              @relation("InventoryMaintainableProfile", fields: [inventoryItemId], references: [id], onDelete: Cascade)
  unitTypeConfig MaintenanceUnitTypeConfig? @relation("UnitTypeConfigProfiles", fields: [unitTypeConfigId], references: [id])

  @@index([assetType])
  @@index([unitTypeConfigId])
  @@index([priority])
}

model MaintenanceUnitTypeConfig {
  id                  String   @id @default(uuid())
  unitType            String   @unique
  defaultCooldownDays Int
  notes               String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  profiles MaintainableAssetProfile[] @relation("UnitTypeConfigProfiles")
}

model RunHourReading {
  id                    String   @id @default(uuid())
  hours                 Decimal  @db.Decimal(10, 2)
  recordedAt            DateTime @default(now())
  maintenanceScheduleId String
  recordedById          String

  maintenanceSchedule MaintenanceSchedule @relation("ScheduleRunHourReadings", fields: [maintenanceScheduleId], references: [id], onDelete: Cascade)
  recordedBy          User                @relation("RunHourReadingRecordedBy", fields: [recordedById], references: [id])

  @@index([maintenanceScheduleId])
  @@index([recordedById])
}

model MaterialEstimate {
  id                   String                @id @default(uuid())
  category             String?
  itemNo               String?
  description          String
  quantity             Decimal               @db.Decimal(15, 4)
  unit                 String
  unitCost             Decimal               @db.Decimal(19, 4)
  createdAt            DateTime              @default(now())
  projectId            String
  updatedAt            DateTime              @updatedAt
  project              Project               @relation("ProjectEstimates", fields: [projectId], references: [id], onDelete: Cascade)
  purchaseRequestItems PurchaseRequestItem[] @relation("EstimatePRItems")

  @@index([projectId])
}

model PurchaseRequest {
  id                    String                @id @default(uuid())
  controlNo             String                @unique
  purpose               String?
  status                PurchaseRequestStatus @default(PENDING)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  projectId             String?
  requestedById         String
  approvedById          String?
  approvedAt            DateTime?
  budgetAllocationId    String?
  isActive              Boolean               @default(true)
  requestingOfficeId    String?
  sourcedInventoryItems InventoryItem[]       @relation("SourcedInventoryItems")
  approvedBy            User?                 @relation("ApprovedPurchaseRequests", fields: [approvedById], references: [id])
  budgetAllocation      BudgetAllocation?     @relation("PurchaseRequestBudget", fields: [budgetAllocationId], references: [id])
  project               Project?              @relation("ProjectPurchaseRequests", fields: [projectId], references: [id])
  requestedBy           User                  @relation("RequestedPurchaseRequests", fields: [requestedById], references: [id])
  requestingOffice      Office?               @relation("OfficePurchaseRequests", fields: [requestingOfficeId], references: [id])
  items                 PurchaseRequestItem[] @relation("PRItems")
  stockMovements        StockMovement[]       @relation("PurchaseStockMovements")

  @@index([projectId])
  @@index([requestedById])
  @@index([status])
  @@index([budgetAllocationId])
  @@index([requestingOfficeId])
}

model PurchaseRequestItem {
  id                 String            @id @default(uuid())
  description        String
  quantity           Decimal           @db.Decimal(15, 4)
  unit               String
  unitCost           Decimal           @db.Decimal(19, 4)
  purchaseRequestId  String
  materialEstimateId String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  materialEstimate   MaterialEstimate? @relation("EstimatePRItems", fields: [materialEstimateId], references: [id])
  purchaseRequest    PurchaseRequest   @relation("PRItems", fields: [purchaseRequestId], references: [id], onDelete: Cascade)

  @@index([purchaseRequestId])
}

model AuditLog {
  id            String   @id @default(uuid())
  action        String
  entityType    String
  entityId      String
  description   String?
  metadata      Json?
  performedById String
  createdAt     DateTime @default(now())
  performedBy   User     @relation("AuditPerformer", fields: [performedById], references: [id])

  @@index([entityType, entityId])
  @@index([performedById])
  @@index([createdAt])
}

model SequenceCounter {
  type      String
  year      Int
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([type, year])
}

model BorrowRequest {
  id              String              @id @default(uuid())
  inventoryItemId String
  requestedById   String
  status          BorrowRequestStatus @default(PENDING)
  quantity        Decimal             @db.Decimal(15, 4)
  reason          String?
  approvedById    String?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  returnedAt      DateTime?
  transactionId   String?             @unique
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  decisionNotes   String?
  dueDate         DateTime?
  approvedBy      User?               @relation("BorrowApprover", fields: [approvedById], references: [id])
  inventoryItem   InventoryItem       @relation("BorrowRequests", fields: [inventoryItemId], references: [id])
  requestedBy     User                @relation("BorrowRequester", fields: [requestedById], references: [id])
  transaction     ItemTransaction?    @relation("BorrowTransaction", fields: [transactionId], references: [id])

  @@index([status])
  @@index([inventoryItemId])
}

enum PersonType {
  STUDENT
  STAFF
  VISITOR
  EXTERNAL
  CONTRACTOR
}

enum Trade {
  CARPENTRY
  ELECTRICAL
  PLUMBING
  MASONRY
  PAINTING
  METALWORK
  GENERAL
}

enum ItemStatus {
  GOOD_CONDITION
  BORROWED
  UNDER_REPAIR
  DAMAGED
  LOST
  FOR_DISPOSAL
  DISPOSED
  RESERVED
}

enum ItemType {
  CONSUMABLE
  ASSET
  TOOL
}

enum Campus {
  MC1
  MC2
  PAMPLONA
}

enum ProjectType {
  CONSTRUCTION
  RENOVATION
  FABRICATION
}

enum ProjectStatus {
  ONGOING
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum StockMovementType {
  RECEIVED
  WITHDRAWN
  ADJUSTED
  RETURNED
}

enum TransactionType {
  ISSUANCE
  WITHDRAWAL
  RETURN
}

enum TransferStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum RequestType {
  REGULAR_MAINTENANCE
  REPAIR
  FABRICATION
  INSTALLATION
  REPLACEMENT
  PLAN_DESIGN
  BAYANIHAN
  OTHERS
}

enum RequestStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AssignmentRole {
  LEAD
  MEMBER
}

enum PurchaseRequestStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum BorrowRequestStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RequestPriority {
  NOT_URGENT
  URGENT
}

enum MaintainableAssetType {
  AIRCON
  GENERATOR
  PUMP
  OTHER
}

enum MaintenanceBasis {
  CALENDAR   // aircons — driven by frequencyDays
  RUNTIME    // generators/pumps — driven by running hours
}

enum MaintenancePriority {
  ROUTINE
  IMPORTANT
  CRITICAL
}